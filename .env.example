# Prefer mongodb+srv; if querySrv ECONNREFUSED, the app forces 8.8.8.8 DNS.
# Or use standard URI: mongodb://USER:PASS@host1:27017,host2:27017,host3:27017/govi_isuru?ssl=true&replicaSet=atlas-...&authSource=admin
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/govi_isuru?retryWrites=true&w=majority
JWT_SECRET=change_me_min_32_chars
REFRESH_TOKEN_SECRET=change_me_min_32_chars
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
ML_SERVICE_URL=http://localhost:8000
AI_SERVICE_URL=http://localhost:8000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NEWS_API_KEY=
WEATHER_API_KEY=
GEMINI_API_KEY=
DAILY_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=
